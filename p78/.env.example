# 服务端口配置
AUTH_SERVICE_PORT=3001
MATERIAL_SERVICE_PORT=3002
TRACE_SERVICE_PORT=3003
QUALITY_SERVICE_PORT=3004
BATCH_SERVICE_PORT=3005
THIRDPARTY_SERVICE_PORT=3006
GATEWAY_PORT=3000

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# 数据库配置 - 分库存储
# 权限认证库
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres

# 原料信息库
MATERIAL_DB_HOST=localhost
MATERIAL_DB_PORT=5432
MATERIAL_DB_NAME=material_db
MATERIAL_DB_USER=postgres
MATERIAL_DB_PASSWORD=postgres

# 溯源记录库
TRACE_DB_HOST=localhost
TRACE_DB_PORT=5432
TRACE_DB_NAME=trace_db
TRACE_DB_USER=postgres
TRACE_DB_PASSWORD=postgres

# 品质数据库
QUALITY_DB_HOST=localhost
QUALITY_DB_PORT=5432
QUALITY_DB_NAME=quality_db
QUALITY_DB_USER=postgres
QUALITY_DB_PASSWORD=postgres

# 批次管理库
BATCH_DB_HOST=localhost
BATCH_DB_PORT=5432
BATCH_DB_NAME=batch_db
BATCH_DB_USER=postgres
BATCH_DB_PASSWORD=postgres

# 第三方检测机构配置
THIRD_PARTY_API_URL=https://api.testing-lab.com
THIRD_PARTY_API_KEY=your-third-party-api-key
