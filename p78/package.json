{
  "name": "distributed-traceability-system",
  "version": "1.0.0",
  "description": "分布式古法酿造原料溯源API服务系统",
  "main": "index.js",
  "scripts": {
    "start:auth": "node services/auth-service/server.js",
    "start:material": "node services/material-service/server.js",
    "start:trace": "node services/trace-service/server.js",
    "start:quality": "node services/quality-service/server.js",
    "start:batch": "node services/batch-service/server.js",
    "start:thirdparty": "node services/thirdparty-service/server.js",
    "start:gateway": "node api-gateway/server.js",
    "dev:auth": "nodemon services/auth-service/server.js",
    "dev:material": "nodemon services/material-service/server.js",
    "dev:trace": "nodemon services/trace-service/server.js",
    "dev:quality": "nodemon services/quality-service/server.js",
    "dev:batch": "nodemon services/batch-service/server.js",
    "dev:thirdparty": "nodemon services/thirdparty-service/server.js",
    "dev:gateway": "nodemon api-gateway/server.js"
  },
  "keywords": ["traceability", "api", "microservices", "brewing"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "express-http-proxy": "^2.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
