DATABASE_URL=postgresql://username:password@localhost:5432/audio_fingerprint
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_NAME=audio_fingerprint

SAMPLE_RATE=22050
N_FFT=2048
