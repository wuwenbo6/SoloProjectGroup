DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audio_fingerprint
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=audio_fingerprint

SAMPLE_RATE=22050
N_FFT=2048
HOP_LENGTH=512
N_MELS=128
PEAK_NEIGHBORHOOD_SIZE=15
TARGET_FAN_VALUE=10
MIN_HASH_TIME_DELTA=2
MAX_HASH_TIME_DELTA=100
FINGERPRINT_REDUCTION=40
PEAK_THRESHOLD_STD=0.8
MAX_PEAKS_PER_SECOND=50

TOP_N_MATCHES=5
SCORE_THRESHOLD=0.3
MIN_ALIGNMENT_SCORE=3
