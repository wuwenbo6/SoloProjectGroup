PORT=3000
NODE_ENV=development

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

MATERIAL_DB_URI=mongodb://localhost:27017/material_db
TRACE_DB_URI=mongodb://localhost:27017/trace_db
QUALITY_DB_URI=mongodb://localhost:27017/quality_db
AUTH_DB_URI=mongodb://localhost:27017/auth_db

THIRD_PARTY_API_URL=https://api.testing-agency.com
THIRD_PARTY_API_KEY=your_third_party_api_key

ENCRYPTION_KEY=your_32_byte_encryption_key_here_please_change_in_production
REQUIRE_SIGNATURE=false

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

MAX_CONCURRENT_REQUESTS=100
MAX_QUEUE_SIZE=500
REQUEST_TIMEOUT=30000
