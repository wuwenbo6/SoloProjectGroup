<?xml version="1.0"?>
<robot name="6_dof_robot_arm" xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  
  <material name="blue">
    <color rgba="0.0 0.5 1.0 1.0"/>
  </material>
  
  <material name="red">
    <color rgba="1.0 0.2 0.2 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14159" upper="3.14159" velocity="3.14"/>
  </joint>

  <link name="link1">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0.075 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.15"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 0 0" xyz="0 0.15 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.5708" upper="1.5708" velocity="3.14"/>
  </joint>

  <link name="link2">
    <visual>
      <origin rpy="0 0 0" xyz="0.1 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0 0 0" xyz="0.2 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.5708" upper="1.5708" velocity="3.14"/>
  </joint>

  <link name="link3">
    <visual>
      <origin rpy="0 0 0" xyz="0.075 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.15"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy="0 0 0" xyz="0.15 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-3.14159" upper="3.14159" velocity="3.14"/>
  </joint>

  <link name="link4">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0.025 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="0 0 0" xyz="0 0.05 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-1.5708" upper="1.5708" velocity="3.14"/>
  </joint>

  <link name="link5">
    <visual>
      <origin rpy="-1.5708 0 0" xyz="0 0.05 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="end_effector"/>
    <origin rpy="0 0 0" xyz="0 0.1 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="-3.14159" upper="3.14159" velocity="3.14"/>
  </joint>

  <link name="end_effector">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0.04 0"/>
      <geometry>
        <box size="0.02 0.08 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="-0.025 0.02 0"/>
      <geometry>
        <box size="0.01 0.04 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0.025 0.02 0"/>
      <geometry>
        <box size="0.01 0.04 0.01"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

</robot>
