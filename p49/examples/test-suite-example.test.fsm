# Test Case: Transition_Coverage
# Machine: TrafficLight
# Generated: 2024-01-15T00:00:00.000Z
# Steps: 6

test Transition_Coverage {
    initial: Red
    steps: [
        sendEvent("TimerTick")
        sendEvent("TimerTick")
        sendEvent("TimerTick")
        sendEvent("TimerTick")
        sendEvent("TimerTick")
        sendEvent("TimerTick")
    ]
    expected: {
        finalState: "Red"
    }
}

# Event sequence: TimerTick → TimerTick → TimerTick → TimerTick → TimerTick → TimerTick

