# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Database Configuration
## Material Database (contains: materials, users, batches, batch_collections)
MATERIAL_DB_HOST=localhost
MATERIAL_DB_PORT=5432
MATERIAL_DB_NAME=papermaking_material
MATERIAL_DB_USER=postgres
MATERIAL_DB_PASSWORD=postgres

## Collection Database (contains: collections)
COLLECTION_DB_HOST=localhost
COLLECTION_DB_PORT=5432
COLLECTION_DB_NAME=papermaking_collection
COLLECTION_DB_USER=postgres
COLLECTION_DB_PASSWORD=postgres

## Inspection Database (contains: inspections, third_party_agencies)
INSPECTION_DB_HOST=localhost
INSPECTION_DB_PORT=5432
INSPECTION_DB_NAME=papermaking_inspection
INSPECTION_DB_USER=postgres
INSPECTION_DB_PASSWORD=postgres

# Service Ports
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
MATERIAL_SERVICE_PORT=3002
COLLECTION_SERVICE_PORT=3003
INSPECTION_SERVICE_PORT=3004
BATCH_SERVICE_PORT=3005
THIRD_PARTY_SERVICE_PORT=3006

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
MATERIAL_SERVICE_URL=http://localhost:3002
COLLECTION_SERVICE_URL=http://localhost:3003
INSPECTION_SERVICE_URL=http://localhost:3004
BATCH_SERVICE_URL=http://localhost:3005
THIRD_PARTY_SERVICE_URL=http://localhost:3006

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Environment
NODE_ENV=development
