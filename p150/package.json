{
  "name": "3d-collaborative-editor",
  "version": "1.0.0",
  "description": "Collaborative 3D model editor with Three.js, React, WebRTC and CRDT",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "@react-three/fiber": "^8.15.0",
    "@react-three/drei": "^9.88.0",
    "yjs": "^13.6.0",
    "y-webrtc": "^10.2.0",
    "y-protocols": "^1.0.5",
    "zustand": "^4.4.0",
    "express": "^4.18.0",
    "socket.io": "^4.7.0",
    "mongoose": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "nodemon": "^3.0.0",
    "concurrently": "^8.2.0"
  }
}
